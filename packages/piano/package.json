{
  "name": "@repo/piano",
  "description": "Simple HTML/CSS Piano diagram generator",
  "keywords": [
    "music",
    "piano",
    "chords"
  ],
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "browser-env": "^3.3.0",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tonaljs/midi": "^4.10.2",
    "@tonaljs/note": "^4.12.1",
    "change-case": "^5.4.4"
  }
}
