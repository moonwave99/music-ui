{
  "name": "@music-ui/piano",
  "description": "Simple HTML/CSS Piano diagram generator",
  "keywords": [
    "music",
    "piano",
    "chords"
  ],
  "version": "0.3.0",
  "exports": {
    "./*": "./src/*.ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "build": "tsup src/index.ts src/styles/index.css  --format cjs,esm --dts",
    "check-types": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@music-ui/eslint-config": "workspace:*",
    "@music-ui/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@tonaljs/midi": "^4.10.2",
    "@tonaljs/note": "^4.12.1",
    "change-case": "^5.4.4"
  }
}
