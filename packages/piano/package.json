{
  "name": "@music-ui/piano",
  "description": "Simple piano diagram generator",
  "homepage": "https://github.com/moonwave99/music-ui",
  "keywords": [
    "music",
    "piano",
    "chords"
  ],
  "version": "0.12.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint . --max-warnings 0",
    "dev": "tsup src/index.ts src/styles/index.css --format cjs,esm --dts --watch",
    "build": "tsup src/index.ts src/styles/index.css --format cjs,esm --dts",
    "check-types": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@music-ui/eslint-config": "workspace:*",
    "@music-ui/typescript-config": "workspace:*",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "^9.39.1",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@music-ui/core": "workspace:*",
    "@tonaljs/midi": "^4.10.2",
    "@tonaljs/note": "^4.12.1",
    "change-case": "^5.4.4"
  }
}
